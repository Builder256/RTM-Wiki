---
import Image from 'astro/components/Image.astro';

import Fallback from '../content/images/items/fallback.svg';
import CraftingTable from '../content/images/items/minecraft/crafting-table.png';
import Glass from '../content/images/items/minecraft/glass.png';
import RoseRed from '../content/images/items/minecraft/rose-red.svg';
import SteelIngot from '../content/images/items/rtm/steel-ingot.svg';
import Marker from '../content/images/items/rtm/marker.svg';
import RTMWorkBench from '../content/images/items/rtm/rtm-workbench.png';
import RailWorkBench from '../content/images/items/rtm/rail-workbench.png';

import { isItemStack, type ItemStack, type StackAmount } from '../scripts/util';

type SlotSize = 'normal' | 'large';

interface Props {
  item?: ItemStack;
  size?: SlotSize;
}

const { item, size } = Astro.props;

let slotSizeClass = 'slot--size18';

if (size === 'large') {
  slotSizeClass = 'slot--size26';
}

const itemMap: Record<string, ImageMetadata | undefined> = {
  'Crafting Table': CraftingTable,
  Glass: Glass,
  'Rose Red': RoseRed,
  'Steel Ingot': SteelIngot,
  Marker: Marker,
  'RTM WorkBench': RTMWorkBench,
  'Rail WorkBench': RailWorkBench,
};

let slotItem: ImageMetadata | null = null;
let itemName: string = '';
if (item) {
  itemName = Array.isArray(item) ? item[0] : item;
  slotItem = itemMap[itemName] ?? Fallback;
}
let itemAmount: StackAmount = !isItemStack(item) ? 0 : Array.isArray(item) ? item[1] : 1;
---

<div class:list={['slot', slotSizeClass]}>
  {
    slotItem ? (
      <div class="slot__item-wrapper">
        <Image src={slotItem} alt={itemName} class="slot__item" />
        {itemAmount > 1 && <div class="item__amount" />}
      </div>
    ) : (
      <div aria-label="空のスロット" />
    )
  }
</div>

<style>
  div,
  img {
    margin-top: 0;
  }
  .slot {
    position: relative;
    background-color: #8b8b8b;
    border-width: var(--px);
    border-style: solid;
    border-top-color: #373737;
    border-left-color: #373737;
    border-bottom-color: #ffffff;
    border-right-color: #ffffff;
    display: grid;
    place-items: center;
  }
  .slot::before {
    content: '';
    position: absolute;
    width: var(--px);
    height: var(--px);
    background: #8b8b8b;
    bottom: calc(var(--px) * -1);
    left: calc(var(--px) * -1);
  }
  .slot::after {
    content: '';
    position: absolute;
    width: var(--px);
    height: var(--px);
    background: #8b8b8b;
    top: calc(var(--px) * -1);
    right: calc(var(--px) * -1);
  }
  .slot.slot--size18 {
    width: var(--px-18);
    height: var(--px-18);
  }
  .slot.slot--size26 {
    width: var(--px-26);
    height: var(--px-26);
  }

  .slot__item-wrapper {
    width: var(--px-16);
    height: var(--px-16);

    position: relative;
  }

  .slot__item {
    width: var(--px-16);
    height: var(--px-16);
  }

  .item__amount {
    position: absolute;
    display: flex;
    bottom: calc(var(--px) / -2);
    right: calc(var(--px) / -2);
  }
</style>
