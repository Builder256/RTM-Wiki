  // Wrap the component logic to run when the DOM is ready or when the component is hydrated
  // Since we are not using a custom element wrapper in the HTML above, we can just run this logic.
  // However, for better reusability and Astro compatibility (View Transitions), let's use a custom element or just a script that runs on page load.

  // Simple script approach for now
  function initCheckboxes() {
    const inputs = document.querySelectorAll(
      '.tutorial-checkbox .checkbox-input',
    );

    inputs.forEach((input) => {
      if (!(input instanceof HTMLInputElement)) return;

      const id = input.id;
      const storageKey = `tutorial-progress-${id}`;

      const savedState = localStorage.getItem(storageKey);
      if (savedState === 'true') {
        input.checked = true;
      }

      input.addEventListener('change', () => {
        localStorage.setItem(storageKey, input.checked.toString());
        window.dispatchEvent(new CustomEvent('tutorial-progress-update'));
      });
    });
  }

  initCheckboxes();

  // Support View Transitions
  // document.addEventListener('astro:page-load', initCheckboxes);
</script>
