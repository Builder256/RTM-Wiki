---

<div class="arrow__container">
  <div class="arrow__shaft"></div>
  <div class="arrow__arrowhead">
    <div class="arrowhead__1"></div>
    <div class="arrowhead__2"></div>
    <div class="arrowhead__3"></div>
    <div class="arrowhead__4"></div>
    <div class="arrowhead__5"></div>
    <div class="arrowhead__6"></div>
    <div class="arrowhead__7"></div>
    <div class="arrowhead__8"></div>
  </div>
</div>

<style>
  div {
    margin-top: 0;
  }

  .arrow__container {
    width: var(--px-22);
    height: var(--px-15);
    display: flex;
    align-items: center;
  }
  .arrow__shaft {
    width: var(--px-14);
    height: var(--px-3);
    background-color: #8b8b8b;
  }
  .arrow__arrowhead {
    width: var(--px-8);
    height: var(--px-15);
    display: flex;
    align-items: center;
  }
  .arrow__arrowhead > * {
    width: var(--px);
    background-color: #8b8b8b;
  }
  .arrowhead__1 {
    height: var(--px-15);
  }
  .arrowhead__2 {
    height: var(--px-13);
  }
  .arrowhead__3 {
    height: var(--px-11);
  }
  .arrowhead__4 {
    height: var(--px-9);
  }
  .arrowhead__5 {
    height: var(--px-7);
  }
  .arrowhead__6 {
    height: var(--px-5);
  }
  .arrowhead__7 {
    height: var(--px-3);
  }
  .arrowhead__8 {
    height: var(--px);
  }
</style>
